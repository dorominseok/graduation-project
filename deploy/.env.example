# 운영 환경변수. 서버에서 `cp .env.example .env` 후 채운다. .env는 git에 올라가지 않는다.

# 접속 주소. 인증서가 이 주소로 발급된다
DOMAIN=balancefit.duckdns.org

POSTGRES_DB=fitness
POSTGRES_USER=fitness
# 아래 둘은 서버에서 새로 만든다:  openssl rand -base64 32
POSTGRES_PASSWORD=
# JWT 서명 키 (HS256, 32바이트 이상). 바꾸면 모든 사용자가 다시 로그인해야 한다
JWT_SECRET=

# 루틴 LLM (LOG-41). true로 켜면 키가 있어야 기동한다. 키는 Google AI Studio에서 이 프로젝트 전용으로
LLM_ENABLED=false
GEMINI_API_KEY=

# 웹 푸시 알림(「알림_설계서」). 로컬에서 cd backend && ./gradlew vapidKeys 로 만든 두 줄을 그대로 붙인다.
# 비어 있으면 알림을 보내지 않는다. 비밀키는 이 서버의 .env에만 두고 저장소·대화에 남기지 않는다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
